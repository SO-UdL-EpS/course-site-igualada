[0.02, "o", "\u001b[2J\u001b[H"]
[0.07, "o", "\u001b[1;36mARBRE DE PROCESSOS · Linux\u001b[0m\r\n"]
[0.09, "o", "════════════════════════════════════════════════════════════════════════════════════════════\r\n"]
[0.12, "o", "PID 1 és l'arrel dels processos d'usuari i del sistema.\r\n"]
