[6.524538, "o", "#!/bin/bash\r\n# Un procés en cada estat i un sol ps per veure'ls tots.\r\nsleep 60 &                                  # S: dorm esperant el temporitzador\r\nsleep 60 & kill -STOP $!                    # T: aturat per senyal (job control)\r\n./zombie1 &                                 # Z: el fill ha acabat i ningú no l'ha recollit\r\n./vfork_d &                                 # D: el pare d'un vfork() espera al fill\r\ntimeout 60 sh -c 'while :; do :; done' &    # R: bucle actiu, consumeix CPU\r\nsleep 1\r\nSID=$(ps -o sid= -p $$ | tr -d ' ')\r\nps --forest -o pid,ppid,stat,wchan:22,cmd --sid \"$SID\"\r\npkill -P $$ ; pkill -x -f 'zombie1|vfork_d|sleep 60' ; true\r\n"]
[6.524728, "o", "\u001b[1;32mso\u001b[0m:\u001b[1;34m~/demo\u001b[0m$ "]
