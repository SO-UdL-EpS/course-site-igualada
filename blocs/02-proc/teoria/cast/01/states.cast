[8.694072, "o", "  PID  PPID STAT WCHAN                  CMD\r\n"]
[8.694111, "o", "  447   445 Ss   do_wait                bash --noprofile --norc -i\r\n"]
[8.694124, "o", "  460   447 S+   do_wait                 \\_ /bin/bash ./states.sh\r\n"]
[8.694138, "o", "  461   460 S+   hrtimer_nanosleep           \\_ sleep 60\r\n"]
[8.694156, "o", "  462   460 T+   do_signal_stop              \\_ sleep 60\r\n"]
[8.694172, "o", "  463   460 S+   hrtimer_nanosleep           \\_ ./zombie1\r\n"]
[8.694189, "o", "  467   463 Z+   -                           |   \\_ [zombie1] <defunct>\r\n"]
[8.694205, "o", "  464   460 D+   kernel_clone                \\_ ./vfork_d\r\n"]
[8.694219, "o", "  468   464 S+   hrtimer_nanosleep           |   \\_ ./vfork_d\r\n"]
[8.694237, "o", "  465   460 S    sigsuspend.isra.0           \\_ timeout 60 sh -c while :; do :; done\r\n"]
[8.69425, "o", "  469   465 R    -                           |   \\_ sh -c while :; do :; done\r\n"]
