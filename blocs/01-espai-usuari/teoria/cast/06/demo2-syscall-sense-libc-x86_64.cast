[1.014961, "o", "static long my_write(int fd, const void *buf, unsigned long n)\r\n{\r\n    long ret;\r\n    __asm__ volatile (\"syscall\"\r\n        : \"=a\"(ret)\r\n        : \"a\"(1), \"D\"(fd), \"S\"(buf), \"d\"(n)\r\n        : \"rcx\", \"r11\", \"memory\");\r\n    return ret;\r\n}\r\n\r\nint main(void) { my_write(1, \"Hello\\n\", 6); return 0; }\r\n"]
