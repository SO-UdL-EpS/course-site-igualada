[0.7025, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <sys/resource.h>\r\n\r\nstatic long minflt(void)\r\n{\r\n    struct rusage r;\r\n    getrusage(RUSAGE_SELF, &r);\r\n    return r.ru_minflt;\r\n}\r\n\r\nint main(void)\r\n{\r\n    size_t n = 256UL << 20;                  /* 256 MiB */\r\n    long a = minflt();\r\n    char *p = malloc(n);\r\n    long b = minflt();\r\n    for (size_t i = 0; i < n; i += 4096) p[i] = 1;\r\n    long c = minflt();\r\n    printf(\"abans=%ld  malloc=%ld  despres de tocar=%ld\\n\", a, b, c);\r\n    return 0;\r\n}\r\n"]
