[0.854828, "o", "#include <stdio.h>\r\n#include <string.h>\r\n#include <errno.h>\r\n#include <unistd.h>\r\n\r\nint main(void)\r\n{\r\n    char *p = (char *)0x1;\r\n    long r = write(1, p, 10);                       /* la syscall rebutja l'adreca */\r\n    fprintf(stderr, \"write -> %ld (%s)\\n\", r, strerror(errno));\r\n\r\n    r = write(1, (void *)0xffff800000000000UL, 10); /* adreca del kernel */\r\n    fprintf(stderr, \"write(kernel) -> %ld (%s)\\n\", r, strerror(errno));\r\n\r\n    *p = 'x';                                       /* acces directe des d'user */\r\n    return 0;\r\n}\r\n"]
