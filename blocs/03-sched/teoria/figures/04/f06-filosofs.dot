digraph f06 {
  layout=circo;
  node [fontname="Helvetica", fontsize=13];
  node [shape=circle, style=filled, fillcolor="#add8e6", width=0.5, fixedsize=true];
  F0; F1; F2; F3; F4;
  node [shape=box, style=filled, fillcolor="#ffffe0", width=0.45, height=0.45, fixedsize=true];
  f0 [label="0"]; f1 [label="1"]; f2 [label="2"]; f3 [label="3"]; f4 [label="4"];
  f0 -> F0; F0 -> f1 [color="#c0392b", penwidth=2];
  f1 -> F1; F1 -> f2 [color="#c0392b", penwidth=2];
  f2 -> F2; F2 -> f3 [color="#c0392b", penwidth=2];
  f3 -> F3; F3 -> f4 [color="#c0392b", penwidth=2];
  f4 -> F4; F4 -> f0 [color="#c0392b", penwidth=2];
}